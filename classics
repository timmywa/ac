            <div class="player-container" id="stream-player-slot">
                <p class="player-placeholder-text">📻 Launching Soon!</p>
                <p class="player-placeholder-sub">Stream player & real-time now-playing info will appear here.</p>
            </div>

            <!-- Social Media Section -->
